# Copie para .env e ajuste. Todas as variáveis são opcionais.

# Porta HTTP do servidor (overlay em http://localhost:3000/ e painel em /painel)
PORT=3000

# Usuário do TikTok (sem @) cuja live será conectada.
TIKTOK_USERNAME=

# Conectar automaticamente ao iniciar (true/false). Precisa de TIKTOK_USERNAME.
AUTO_CONNECT=false

# Chave da API de assinatura Euler Stream (https://www.eulerstream.com). Opcional, mas
# aumenta muito o limite de conexões (sem chave o limite gratuito é pequeno).
# Também pode ser colada pelo painel (/painel), que a salva no servidor.
SIGN_API_KEY=

# Buscar o catálogo completo de presentes do TikTok ao conectar (true/false).
# Deixe FALSE: essa busca usa uma rota que hoje exige plano Business da Euler Stream e faz a
# conexão falhar. O nome, o valor em moedas e a imagem do presente já vêm no próprio evento.

# Sessão autenticada (opcional). Só é necessária para recursos avançados; NUNCA compartilhe.
# sessionid e tt-target-idc são cookies do site do TikTok (usuário logado).
TIKTOK_SESSION_ID=
TIKTOK_TT_TARGET_IDC=

# Overrides de configuração do overlay enviados no "hello" (JSON), ex.: {"gridSize":14,"quality":"medium"}
OVERLAY_CONFIG=

# ---- Servidor de Minecraft (npm run minecraft) ----------------------------------------------
# Obrigatório para o servidor subir: true = você leu e aceita a EULA do Minecraft
# (https://aka.ms/MinecraftEULA).
MC_EULA=false

# Versão do Minecraft. "latest" = a mais nova com build STABLE do Paper. Ex.: 26.2
MC_VERSION=latest

# RAM do servidor (Xms = Xmx). 2G aguenta uns 10 jogadores; 4G para mais gente/mods.
MC_MEMORY=2G

# Porta do servidor (padrão do Minecraft: 25565).
MC_PORT=

# Caminho do Java, se o "java" do PATH for antigo (o Minecraft 26.x pede Java 25).
JAVA_BIN=
